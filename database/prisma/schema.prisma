datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PUBLIC_VISITOR
  LEARNER
  PARENT
  TEACHER
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum CourseStatus {
  DRAFT
  DEVELOPMENT_PREVIEW
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  fullName      String
  role          UserRole  @default(LEARNER)
  passwordHash  String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  enrollments   Enrollment[]
  orders        Order[]
  progress      LessonProgress[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Course {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  subtitle     String?
  description  String
  priceAmount  Int          @default(0) // Integer minor currency units (paisa)
  currency     String       @default("INR")
  status       CourseStatus @default(DEVELOPMENT_PREVIEW)
  instructor   String       @default("Dr. Nivedita Ganguli")
  thumbnailUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  orders      Order[]

  @@map("courses")
}

model Lesson {
  id            String   @id @default(uuid())
  courseId      String
  title         String
  slug          String?
  description   String?
  orderIndex    Int
  durationMin   Int?
  videoUrl      String?
  isFreePreview Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  progressPct Int       @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String
  lessonId        String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  lastPositionSec Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  courseId  String
  amount    Int         // Minor units (paisa)
  currency  String      @default("INR")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId])
  @@index([courseId])
  @@map("orders")
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  paymentGateway   String        @default("RAZORPAY")
  gatewayPaymentId String?       @unique
  gatewayOrderId   String?
  gatewaySignature String?
  amount           Int           // Minor units (paisa)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model ContactInquiry {
  id           String        @id @default(uuid())
  name         String
  email        String
  phone        String?
  organization String?
  inquiryType  String        // e.g. "parenting", "schools", "adolescent", "corporate", "general"
  message      String
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PUBLIC_VISITOR
  LEARNER
  PARENT
  TEACHER
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum CourseStatus {
  DRAFT
  DEVELOPMENT_PREVIEW
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  role      UserRole @default(LEARNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  orders      Order[]

  @@map("users")
}

model Course {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  subtitle    String?
  description String
  priceAmount Int          @default(0) // Integer minor currency units (paisa)
  currency    String       @default("INR")
  status      CourseStatus @default(DEVELOPMENT_PREVIEW)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  orders      Order[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  orderIndex  Int
  durationMin Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime @default(now())
  progressPct Int      @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  courseId    String
  amount      Int         // Minor units
  currency    String      @default("INR")
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@map("orders")
}

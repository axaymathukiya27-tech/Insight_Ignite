{
  "name": "insight-ignite-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@insight-ignite/web",
    "dev:web": "npm run dev --workspace=@insight-ignite/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@insight-ignite/web",
    "start": "npm run start --workspace=@insight-ignite/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint --workspace=@insight-ignite/web"
  }
}
